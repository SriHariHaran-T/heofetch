#!/usr/bin/env bash
logo(){
source ./logo
}

information(){
source ./information
} 

RED_FC="31"
BLUE_FC="34"
WHITE_FC="37"
WHITE="\033[0;${WHITE_FC}m"
BOLDWHITE="\033[1;${WHITE_FC}m"
BOLDRED="\033[1;${RED_FC}m"
ENDCOLOR="\033[0m"
BOLDBLUE="\033[1;${BLUE_FC}m"
FAINTBLUE="\033[2;${BLUE_FC}m"

mapfile -t INFO < <(./information)
mapfile -t LOGO < <(./logo)

if [[ -z "$@" ]]; then
    for i in "${!LOGO[@]}"; do
	printf '%b %-30s %s\n' "$BOLDBLUE" "${LOGO[$i]}" "${INFO[$i]}"
    done 

else
    while [ "$#" -gt 0 ]; do
    case "$1" in
	-h | --help)
	    echo -e "${BOLDBLUE}heofetch${ENDCOLOR}""   	"Show system information
	    echo -e "${BOLDBLUE}--help${ENDCOLOR}""   	"Show help and stop
	    echo -e "${BOLDBLUE}--version${ENDCOLOR}""   	"Show version and stop
	    echo -e "${BOLDBLUE}--json${ENDCOLOR}""   	"Show JSON format and stop
	    echo -e "${BOLDBLUE}--follow${ENDCOLOR}""   	"Follow me in Instagram!
	    shift
	    ;;
	-v | --version)
	    echo -e "${BOLDBLUE}VERSION${ENDCOLOR}: 1.0 (INDEV)"
	    shift
	    ;;
	-f | --follow)
	    echo -e "${BOLDBLUE}FOLLOW ME${ENDCOLOR}: \033]8;;http://instagram.com/heodoestech/\033\\\\${FAINTBLUE}Instagram${ENDCOLOR}\033]8;;\033\\\\"
	    shift
	    ;;
	-j | --json)
	    printf '%bSystem Information: \n' "$BOLDBLUE" 
	    information
	    printf '\n%bJSON Output: \n' "$BOLDBLUE"

	    printf '%b\n{\n"user": "%s", \n"os": "%s", \n"kernel": "%s", \n"cpu": "%s", \n"gpu": "%s", \n"cpucores": %d, \n"uptime": "%s", \n"ram": "%s" \n}' "$WHITE" "$CURRENT_USER" "$OS $MACH" "$KERNEL" "$CPU" "$GPU" "$CPUCORES" "$UPTIME" "$RAM"
	    shift
	    ;;
	*)
	    echo "Unkown argument: $1 Use heofetch {--help} for more information"
	    exit 1
	    ;;
	esac
    done
fi
    

